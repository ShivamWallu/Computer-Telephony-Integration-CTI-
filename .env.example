# ==============================================================================
# Enterprise CTI & Customer Management System - Environment Configuration
# ==============================================================================

# Application & Environment
PROJECT_NAME="Enterprise CTI & Customer Management CRM"
ENVIRONMENT="production"
PORT=8000
HOST="127.0.0.1"

# PostgreSQL Database Configuration
# In Production on Vercel: Use Neon, Supabase, AWS RDS, Render, etc.
# In Local Development: If left blank or sqlite, automatically falls back to local SQLite
DATABASE_URL="postgresql://user:password@ep-cool-db-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# Security & JWT Token Authentication
JWT_SECRET="your-super-secure-jwt-secret-key-at-least-32-chars-long"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CTI Webhook & Telephony Integration
CTI_WEBHOOK_SECRET="your-telephony-webhook-secret-token"
DEFAULT_COUNTRY_CODE="91"

# Transactional Email Service Configuration
# Supported providers: "mock", "smtp", "resend", "sendgrid"
EMAIL_PROVIDER="mock"
EMAIL_FROM="crm-notifications@yourcompany.com"
EMAIL_API_KEY=""

# SMTP Settings (when EMAIL_PROVIDER="smtp")
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="notifications@yourcompany.com"
SMTP_PASSWORD="your-smtp-app-password"
SMTP_TLS="true"
